# Copy to .env and fill in. Never commit .env.

# Bolna dashboard -> Developers -> API keys
BOLNA_API_KEY=

# Bolna dashboard -> your agent -> copy its ID
BOLNA_AGENT_ID=

# Optional. Only needed for the alternative Claude extractor (meoww.extract_cli).
ANTHROPIC_API_KEY=

# Where calls are stored. Defaults to data/calls.jsonl.
MEOWW_STORE=

# Shared secret for the webhook URL. Set this before exposing the server.
MEOWW_WEBHOOK_SECRET=
